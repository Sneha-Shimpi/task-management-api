{
  "info": {
    "name": "Task Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "task_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Create Task",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('task_id', body.id);",
              "pm.test('Status is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Write project README\",\n  \"description\": \"Document setup and usage\",\n  \"priority\": \"high\"\n}"
        }
      }
    },
    {
      "name": "Create Task - Missing Title (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"no title provided\"\n}"
        }
      }
    },
    {
      "name": "List Tasks",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks"
      }
    },
    {
      "name": "List Tasks - Filter by status/priority",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks?status=todo&priority=high&page=1&per_page=10"
      }
    },
    {
      "name": "Get Task by ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks/{{task_id}}"
      }
    },
    {
      "name": "Get Task - Not Found (404)",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/tasks/999999"
      }
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/tasks/{{task_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\"\n}"
        }
      }
    },
    {
      "name": "Update Task - Invalid Priority (400)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/api/tasks/{{task_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"priority\": \"urgent\"\n}"
        }
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/tasks/{{task_id}}"
      }
    }
  ]
}
